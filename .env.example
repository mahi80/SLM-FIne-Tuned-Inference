# Runtime image. Pinned on purpose; bumping this is a reviewed change.
VLLM_TAG=v0.33.0

# Model artifact. MODEL_REVISION is a commit SHA, never a branch, so that a
# restart cannot silently change the weights under a running release.
MODEL_ID=cyankiwi/Qwen3-4B-Instruct-2507-AWQ-4bit
MODEL_REVISION=b37d1ccb77e27a70fe4222d995fda27940eead5a
SERVED_MODEL_NAME=slm-small

# Host port for the OpenAI-compatible endpoint.
VLLM_PORT=8010

# Only needed for gated weights (e.g. meta-llama/*). Leave empty otherwise.
HF_TOKEN=
