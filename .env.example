# Runtime image. Pinned on purpose; bumping this is a reviewed change.
VLLM_TAG=v0.33.0

# Model artifact. MODEL_REVISION is a commit SHA, never a branch, so that a
# restart cannot silently change the weights under a running release.
MODEL_ID=cyankiwi/Qwen3-4B-Instruct-2507-AWQ-4bit
MODEL_REVISION=b37d1ccb77e27a70fe4222d995fda27940eead5a
SERVED_MODEL_NAME=slm-small

# Host ports. 8000 is left alone because it is routinely occupied on developer
# machines; the GPU tier is reached through the gateway anyway.
VLLM_PORT=8010
GATEWAY_PORT=8020
TIERSIM_PORT=8011
TIERSIM_CLOUD_PORT=8012
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# CPU tier simulation. SPEEDUP=10 makes the tier 10x faster for demos and tests
# while leaving the relative latency shape intact.
TIERSIM_PROFILE=cpu-xeon-4b
TIERSIM_SPEEDUP=1

# Local-only Grafana admin password.
GRAFANA_PASSWORD=admin

# Only needed for gated weights (e.g. meta-llama/*). Leave empty otherwise.
HF_TOKEN=
